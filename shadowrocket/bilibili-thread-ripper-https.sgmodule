#!name=Bilibili 线程撕裂者（移动端 · 含 HTTPS）
#!desc=与默认模块相同，但同时处理 https 的视频分片。需要在 Shadowrocket 里开启 HTTPS 解密并安装、信任证书。只在 App 的分片走 https 时才需要这个版本。设置页：http://btr.settings/
#!author=vic233333
#!homepage=https://github.com/vic233333/Bilibili-thread-ripper-mobile
#!icon=https://raw.githubusercontent.com/MrTangLuyao/Bilibili-thread-ripper/main/icons/icon-128.png
#!category=B 站
#!system=ios

# 原作：MrTangLuyao 的 Bilibili 线程撕裂者（MIT） https://github.com/MrTangLuyao/Bilibili-thread-ripper
# 不要和默认模块同时启用，两者会重复处理同一个请求。

[Script]
btr-media = type=http-request, pattern=^https?:\/\/[^\/]+\.(bilivideo\.(com|cn|net)|akamaized\.net|szbdyd\.com)(:\d+)?\/, argument=mode=https, requires-body=0, timeout=45, engine=webview, script-path=https://raw.githubusercontent.com/vic233333/Bilibili-thread-ripper-mobile/main/shadowrocket/bilibili-thread-ripper.js?role=media&v=0.1.8

btr-settings = type=http-request, pattern=^http:\/\/btr\.settings(?:\/.*)?$, argument=mode=https, requires-body=0, timeout=10, engine=webview, script-path=https://raw.githubusercontent.com/vic233333/Bilibili-thread-ripper-mobile/main/shadowrocket/bilibili-thread-ripper.js?role=settings&v=0.1.8

[Rule]
# 模块里的规则只在全局路由为“配置”时生效。
# App 会先试 QUIC（UDP 443）连视频 CDN，QUIC 无法解密。拒掉它，App 会退回 TCP 的 TLS，MITM 才接得住。
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,akamaized.net)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,bilivideo.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,bilivideo.cn)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,bilivideo.net)),REJECT-NO-DROP

[Host]
# 占位地址，见默认模块里的说明；请求在发出前就被脚本接住。
btr.settings = 185.199.108.153

[MITM]
# 只解密视频 CDN 的域名；B 站接口域名不在其中，脚本不会碰它们。
hostname = %APPEND% *.bilivideo.com, *.bilivideo.cn, *.bilivideo.net, *.akamaized.net
